# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider (RAG answer generation, Module 1) ---
LLM_PROVIDER=openai                 # openai | huggingface | ollama
OPENAI_API_KEY=sk-...
LLM_MODEL_NAME=gpt-3.5-turbo        # or an open-source model id if LLM_PROVIDER=huggingface

# --- Embeddings (Module 1) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store (Module 1) ---
VECTOR_DB_PROVIDER=lancedb          # lancedb | pinecone | weaviate
LANCEDB_URI=./data/lancedb
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
WEAVIATE_URL=

# --- Text generation fine-tuning (Module 2) ---
TEXT_GEN_BASE_MODEL=gpt2
TEXT_GEN_MODEL_DIR=./models/text_generation

# --- Image generation (Module 3) ---
IMAGE_GEN_PROVIDER=stable_diffusion # stable_diffusion | dalle
STABLE_DIFFUSION_MODEL_ID=stabilityai/stable-diffusion-2-1
DALLE_API_KEY=

# --- Backend API (Module 4) ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=30
REDIS_URL=redis://localhost:6379/0

# --- Frontend (Module 4) ---
FRONTEND_API_BASE_URL=http://localhost:8000

# --- Observability (Module 5) ---
LOG_LEVEL=INFO
ENABLE_METRICS=true
